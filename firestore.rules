rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ---- Catalog: authenticated read, no client writes (developer/server only)
    match /items/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Event participation — server-only. Players join/claim through the
    // game server; the admin manages events through the admin API.
    match /eventJoins/{joinId} {
      allow read: if false;
      allow write: if false;
    }
    match /quests/{questId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /achievements/{achievementId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /gameSettings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Players: owner-only; economy/progression fields never client-writable
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'displayName','email','petals','level','xp','createdAt','updatedAt',
             'lastHuntAt','musicEnabled','sfxEnabled','accountStatus'
           ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.petals == 20
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.musicEnabled == true
        && request.resource.data.sfxEnabled == true;
      // Only cosmetic/settings fields are client-writable.
      // petals, xp, level, lastHuntAt, accountStatus, createdAt, email: server only.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','musicEnabled','sfxEnabled','favoriteItemId','updatedAt']);
      allow delete: if false;

      match /achievements/{aid} {
        allow read: if isOwner(uid);
        allow write: if false; // awarded by the game server only
      }
    }

    // ---- Inventory: owner read; only the 'favorite' flag is client-writable
    match /inventories/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorite']);
      allow create, delete: if false; // items granted by the game server only
    }

    // ---- Marketplace: listings are created AND canceled by the game server
    // (POST /api/market/list, POST /api/market/cancel). No client writes:
    // a client-side status flip would strand the escrowed items.
    match /marketplace/{listingId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // ---- Trades: offeredBy creates, offeredTo accepts/cancels; server completes.
    // NOTE on list: Firestore rules cannot inspect a query's where-clauses,
    // so list queries cannot be participant-scoped the way get is. The client
    // only ever queries its own trades (where offeredBy/offeredTo == uid).
    // Trade offers are low-sensitivity (the marketplace is public by design);
    // per-document reads stay participant-only.
    match /trades/{tradeId} {
      function participant() {
        return signedIn() && (resource.data.offeredBy == request.auth.uid
                           || resource.data.offeredTo == request.auth.uid);
      }
      allow get: if participant();
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.offeredBy == request.auth.uid
        && request.resource.data.offeredTo != request.auth.uid
        && request.resource.data.status == 'offered'
        && request.resource.data.offerQty >= 1
        && request.resource.data.wantQty >= 1
        && request.resource.data.keys().hasOnly([
             'offeredBy','offeredTo','offerItemId','offerQty',
             'wantItemId','wantQty','status','createdAt'
           ]);
      allow update: if participant() && (
        // offeredTo accepts the offer
        (resource.data.status == 'offered'
         && request.resource.data.status == 'accepted'
         && resource.data.offeredTo == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','acceptedAt']))
        ||
        // either participant cancels an open trade
        (resource.data.status in ['offered','accepted']
         && request.resource.data.status == 'canceled'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if false;
    }

    // ---- Server-only collections (Admin SDK bypasses rules; clients get nothing)
    match /idempotency/{key} {
      allow read, write: if false;
    }
    match /activityLogs/{logId} {
      allow read, write: if false;
    }

    // ---- Redeem codes: created/managed via the admin API, redeemed via
    // POST /api/redeem. No client reads or writes; the Admin SDK bypasses rules.
    match /redeemCodes/{code} {
      allow read, write: if false;
    }
    match /redeemClaims/{claimId} {
      allow read, write: if false;
    }

    // ---- Social: public traveler profiles (base info only, server-maintained)
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if false; // maintained by the game server only
    }

    // ---- Social: Agora public chat. Readable by all travelers; only level 10+
    // can speak. Under-10 travelers can read but not send.
    match /agora_messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.level >= 10
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.keys().hasOnly(
             ['senderUid','senderName','senderLevel','text','createdAt']
           );
      allow update, delete: if false;
    }

    // ---- Social: friendships. Doc ID is the two UIDs sorted and joined with '_'.
    // List queries are participant-scoped client-side (array-contains own uid);
    // per-document reads stay participant-only like trades.
    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    match /friendships/{fid} {
      function participant() {
        return signedIn() && request.auth.uid in resource.data.users;
      }
      allow get: if participant();
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] != request.resource.data.users[1]
        && fid == friendshipId(
             request.resource.data.users[0], request.resource.data.users[1])
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['users','status','requesterUid','createdAt','updatedAt']);
      allow update: if participant()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','updatedAt'])
        && (
             // recipient accepts the request
             (resource.data.status == 'pending'
              && request.resource.data.status == 'accepted'
              && resource.data.requesterUid != request.auth.uid)
             ||
             // recipient rejects, requester cancels, or either side unfriends
             (request.resource.data.status == 'rejected')
           );
      allow delete: if false;
    }

    // ---- Social: Veyra private chats. Friends-only: creating a chat (and every
    // message) requires an accepted friendship between the two travelers.
    // Chat doc ID uses the same sorted-join scheme as friendships.
    match /private_chats/{chatId} {
      function chatParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow get: if chatParticipant();
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chatId == friendshipId(
             request.resource.data.participants[0],
             request.resource.data.participants[1])
        && get(/databases/$(database)/documents/friendships/$(chatId)).data.status == 'accepted'
        && request.resource.data.keys().hasOnly(
             ['participants','lastMessage','lastMessageAt','updatedAt']);
      allow update: if chatParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage','lastMessageAt','updatedAt']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(
               /databases/$(database)/documents/private_chats/$(chatId)
             ).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(
               /databases/$(database)/documents/private_chats/$(chatId)
             ).data.participants
          && get(/databases/$(database)/documents/friendships/$(chatId)).data.status == 'accepted'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(
               ['senderUid','text','createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
