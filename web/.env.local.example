# Copy to .env.local and fill in real values. Never commit .env.local.
# These are public client values (safe to ship in the static bundle).

# Firebase web config (from Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mythica game server (Render) base URL, e.g. https://mythica-server.onrender.com
# When empty, server-dependent features (hunt/market/trades/upgrade) show an offline notice.
NEXT_PUBLIC_API_URL=

# Sub-path the static site is served from (GitHub Pages repo path, e.g. /mythica).
# Empty string when served from a domain root.
NEXT_PUBLIC_BASE_PATH=
